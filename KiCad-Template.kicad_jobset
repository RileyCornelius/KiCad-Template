    {
      "description": "Generate BOM .CSV",
      "id": "bef7019e-255a-4d81-9c5b-8eb30bbbd256",
      "settings": {
        "bom_format_preset_name": "CSV",
        "bom_preset_name": "",
        "description": "",
        "exclude_dnp": true,
        "field_delimiter": ",",
        "fields_group_by": [
          "Value"
        ],
        "fields_labels": [
          "Reference",
          "Qty",
          "Value",
          "Exclude from BOM",
          "Exclude from Board",
          "Footprint",
          "Datasheet",
          "DNP",
          "Description",
          "#",
          "MPN"
        ],
        "fields_ordered": [
          "Reference",
          "${QUANTITY}",
          "Value",
          "__${EXCLUDE_FROM_BOM}",
          "__${EXCLUDE_FROM_BOARD}",
          "Footprint",
          "__Datasheet",
          "${DNP}",
          "__Description",
          "__${ITEM_NUMBER}",
          "MPN"
        ],
        "filter_string": "",
        "group_symbols": true,
        "keep_line_breaks": false,
        "keep_tabs": false,
        "output_filename": "${PROJECTNAME}-BOM.csv",
        "ref_delimiter": ",",
        "ref_range_delimiter": "",
        "sort_asc": true,
        "sort_field": "Reference",
        "string_delimiter": "\"",
        "variant_names": []
      },
      "type": "sch_export_bom"
    },
